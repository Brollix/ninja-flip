# Cloud Run service "report": relic_analysis.py + report_server.py.
# Build desde la RAIZ del repo: docker build -f scripts/Dockerfile.report -t report .
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY scripts/ ./
ENV PORT=8080
EXPOSE 8080
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--timeout", "540", "--workers", "2", "report_server:app"]
